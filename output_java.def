include: output.def
include: macros/variables.def
include: macros/print.def
include: macros/type.def

page: output_java, inherit, c
    output_dir: lib/MyDef
    ext: java
    package: MyDef::output_java

    subcode: on_init_pre
        $page->{autolist}="page"

    subcode: on_init
        $call @java_init

    #-------------------
    subcode: on_parsecode
        $call class_members_in_scope
        $if $l=~/^\$import\s*(.*)/
            $foreach $p in split /,\s*/, $1
                add_import($p)
            return
        $elif $l=~/^\$print\s*(.*)/
            parse_print($1)
            return
        $elif $l=~/^\$foreach\s*(.+) in (.+)/
            my ($v, $list) = ($1, $2)
            $if $v=~/^\w+$/
                $v = "var $v"
            return $(super:single_block)("for($v : $list){", "}")
        $call @java_parse
    #--------------------
    subcode: on_dumpout
        my $page=$$(super:page)
        $if $page->{package}
            push @$f, "package $page->{package};\n"
        $call dump_import
        my %has_constructor
        $foreach $func in @$(super:function_list)
            $if $func->{name}=~/^(?:(\w+)\.)?_\w*_init$/
                $has_constructor{$1 || $page->{_pagename}}=1
        $call class_wrap
        $call dump_public_private

        $call dump_structs
        $call filter_class_methods

        $foreach $func in @$(super:function_list)
            $call process_function_java
            $func->{skip_declare}=1
            $func->{processed}=1

        MyDef::dumpout::dumpout({out=>$out,f=>$f})
        return

        # -------------------
        subcode: class_wrap
            my $t = "public class $page->{_pagename}"
            $call class_extends_implements

            push @$f, "$t {\n"

            unshift @$out, "INDENT"
            push @$out, "DEDENT", "}\n"

        subcode: dump_public_private
            $(for:public,private)
                $if @$$1_list
                    $foreach $name in @$$1_list
                        my $v = $$1_hash->{$name}
                        my $type = $v->{type}
                        $type=~s/\*/[]/g
                        my $decl="$type $v->{name}"
                        $if !$has_constructor{$page->{_pagename}}
                            $decl = "static $decl"
                        push @$f, "    $1 $decl;\n"
                    push @$f, "\n"

        subcode: process_function_java
            my $name=$func->{name}
            $if $name=~/(\w+)\.(\w+)/
                $func->{name}=$2
                $func->{class}=$1
                $name=$2
            $else
                $func->{class}=$page->{_pagename}
            # ----------------
            $if $name eq "main"
                $func->{skip_makefile}=1
                $func->{return_type}="public static void"
                $func->{param_list}=["String[] args"]
            $elif $name =~/^_(\w*)_init$/
                $func->{return_type}="public"
                $func->{name}=$func->{class}
            $else
                $if $func->{return_type} and $func->{return_type}=~/^(public|private)/
                    NOOP
                $else
                    $if !$func->{return_type}
                        $func->{return_type}="void"
                    $elif $func->{return_type} eq "char*"
                        $func->{return_type}="String"

                    $if $$(super:function_autolist){$name} eq "global"
                        $func->{return_type}="public static $func->{return_type}"
                    $elif $func->{class} eq $page->{_pagename} and !$has_constructor{$func->{class}}
                        # the page class is never instantiated, e.g. basic_frame
                        $func->{return_type}="public static $func->{return_type}"
                    $else
                        $func->{return_type}="public $func->{return_type}"

            $(super:process_function_std)($func)

        # TODO: flag struct member functions
        #       filter @$out 
        #       dump here
        subcode: dump_structs
            my %classes
            $foreach $name in @$(super:struct_list)
                my $st = $$(super:structs){$name}
                my $h  = $st->{hash}
                push @$out, "\n";
                push @$out, "class $name {\n"
                push @$out, "INDENT"
                $foreach $p in @{$st->{list}}
                    my $type = $h->{$p}
                    push @$out, "public $type $p;\n"

                my $s_stub = "_$name\_methods"
                push @$out, "NEWLINE"
                push @$out, "DUMP_STUB $s_stub"
                $classes{$name} = MyDef::compileutil::get_named_block($s_stub)

                push @$out, "DEDENT"
                push @$out, "};\n"

        subcode: filter_class_methods
            my $alt_out
            $foreach $l in @$out
                $if !$alt_out and $l=~/DUMP_STUB fn(\d+)_open/
                    my $func = $$(super:function_list)[$1]
                    $if $func->{name}=~/^(\w+)\.(\w+)/
                        $if $classes{$1}
                            $alt_out = $classes{$1}

                $if $alt_out
                    push @$alt_out, $l

                    $if $l=~/DUMP_STUB fn(\d+)_close/
                        undef $alt_out

                    $l = "NOOP"


#---- struct methods, e.g. fncode: Point.move ----
# fields are in scope, like params: in var_hash but not declared
subcode: class_members_in_scope
    my $func = $$(super:cur_function)
    $if $func and !$func->{_members} and $func->{name}=~/^(\w+)\./
        $func->{_members}=1
        my $st = $$(super:structs){$1}
        $if $st
            $foreach $p in @{$st->{list}}
                $if !$func->{var_hash}->{$p}
                    $func->{var_hash}->{$p}={name=>$p, type=>$st->{hash}->{$p}}

#---- import ---------------------------- 
subcode:: java_init
    $global @import_list, %import_hash
    @import_list=()
    %import_hash=()

fncode: add_import($l)
    $if !$import_hash{$l}
        $import_hash{$l}=1
        push @import_list, $l

subcode: dump_import
    $if @import_list
        push @$f, "\n"
        $foreach $imp in @import_list
            push @$f, "import $imp;\n"
        push @$f, "\n"

#---- extends, implements
subcode:: java_init
    $global @extends, @implements
    @extends=()
    @implements=()

subcode:: java_parse
    $elif $l=~/^\$extends\s*(.+)/
        push @extends, $1
        return
    $elif $l=~/^\$implements\s*(.+)/
        push @implements, $1
        return

subcode: class_extends_implements
    $if @extends
        $t .= " extends ".join(", ", @extends)
    $if @implements
        $t .= " implements ".join(", ", @implements)
#---------------------------------------- 
