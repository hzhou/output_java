include: java/gui.def

macros:
    swing: 1

page: AWTCounter, gui_frame
    module: java
    title: AWT Counter
    # align: center, 10, 10
    size: 350, 100

    $call add_label, -, "Counter"
    $call add_text, txt_count, "0", 10
    $call add_space, 200
    # $call add_glue
    $call add_button, btn_count, "Click"

    $private n_count=0
    &call add_listener, btn_count
        n_count++
        txt_count.setText( $(itoa:n_count))

